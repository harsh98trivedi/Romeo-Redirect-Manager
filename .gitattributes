# Auto detect text files and perform LF normalization
* text=auto

# PHP, JS, CSS, JSON, Markdown, XML
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.pot text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.webp binary

# Export Ignore (exclude repository metadata from release archives)
.git export-ignore
.github export-ignore
.gitignore export-ignore
.gitattributes export-ignore
.distignore export-ignore
.editorconfig export-ignore
phpcs.xml.dist export-ignore
composer.json export-ignore
composer.lock export-ignore
svn export-ignore
