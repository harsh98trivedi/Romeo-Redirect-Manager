# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# WordPress Coding Standards: PHP, JS, CSS use tabs
[*.{php,js,css,scss}]
indent_style = tab
indent_size = 4

# JSON, YAML, Markdown use spaces
[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.txt]
indent_style = tab
indent_size = 4
